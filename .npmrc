# Cau hinh npm theo OWASP A03:2025 - Software Supply Chain Failures

# Chan post-install script cua dependency.
# OWASP A03:2025 neu vu worm "Shai-Hulud" (2025): cac package pho bien bi
# tiem ma doc, dung post-install script de trom token npm roi tu lan sang
# package khac (hon 500 phien ban bi anh huong). Du an nay khong co package
# nao can install script (da kiem tra: 0 package), nen chan hoan toan duoc.
ignore-scripts=true

# Luon ghi version CHINH XAC khi them package moi (khong dung ^ hay ~),
# de "npm install" sau nay khong tu nhay len ban moi chua duoc xem xet.
save-exact=true

# Chi lay package tu registry chinh thuc qua HTTPS
registry=https://registry.npmjs.org/

# Canh bao khi co lo hong tu muc moderate tro len
audit-level=moderate

# Khong gui thong tin du an di kem khi audit
fund=false
