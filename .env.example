# =====================================================================
# Mau cau hinh cho SkyBooking.
#
#   1. Copy file nay thanh .env        cp .env.example .env
#   2. Sinh cac khoa bi mat            npm run gen-key
#   3. Dan ket qua vao .env
#
# KHONG commit file .env (da co trong .gitignore).
# =====================================================================

# --- MySQL: database nghiep vu ---------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=booking

# --- MySQL: database RIENG cho nhat ky audit -------------------------
# Tach DB + tach quyen: app KHONG THE sua hay xoa nhat ky da ghi.
#   writer : chi co quyen INSERT  (duong ghi log)
#   reader : chi co quyen SELECT  (nap hash chain, verify, admin xem log)
# Khoi tao 1 lan:  npm run setup-audit
AUDIT_DB_NAME=booking_audit
AUDIT_DB_WRITER_USER=booking_audit_w
AUDIT_DB_WRITER_PASSWORD=
AUDIT_DB_READER_USER=booking_audit_r
AUDIT_DB_READER_PASSWORD=

# --- Web server ------------------------------------------------------
PORT=3000

# development | production
# O production, server TU CHOI khoi dong neu phat hien khoa yeu.
NODE_ENV=development

# --- HTTPS -----------------------------------------------------------
# Co ca 2 duong dan -> Node chay HTTPS truc tiep (TLS >= 1.2).
# De TRONG ca 2 -> chay HTTP (chi dung cho localhost, hoac khi dung sau
# reverse proxy nginx/Caddy da lo HTTPS).
# Tao chung chi tu ky:  npm run gen-cert
HTTPS_KEY_FILE=certs/server.key
HTTPS_CERT_FILE=certs/server.crt

# HSTS buoc trinh duyet chi dung HTTPS voi host nay.
# CANH BAO: HSTS ap dung cho CA HOST, khong phan biet cong. Bat tren
# localhost se lam MOI du an khac cua ban tren localhost bi buoc sang
# HTTPS va hong. Chi bat khi deploy len domain that.
ENABLE_HSTS=false

# So lop reverse proxy tin cay phia truoc (de doc dung IP that cua khach).
# PHAI DE TRONG khi Node tu chay HTTPS truc tiep! Neu bat ma khong co
# proxy that, ai cung gui duoc "X-Forwarded-For: <ip gia>" de bypass
# rate limit va dau doc cot ip trong nhat ky audit.
# Dat = 1 khi THUC SU dung sau nginx/Caddy; = 2 neu co 2 lop proxy.
TRUST_PROXY=

# Origin duoc phep goi API tu domain khac (CORS), cach nhau bang dau phay.
# De TRONG = chi cho phep cung origin (an toan nhat). VD: https://myapp.com
ALLOWED_ORIGINS=

# --- Gioi han tai (chong can kiet tai nguyen) ------------------------
MAX_CONCURRENT_REQUESTS=200
MAX_CONNECTIONS=512

# --- Khoa bi mat -----------------------------------------------------
# Sinh toan bo bang:  npm run gen-key

# Khoa truy cap trang quan tri. Can >= 16 ky tu ngau nhien.
ADMIN_KEY=

# Khoa ky token phien dang nhap admin (HMAC-SHA256). Can >= 32 ky tu.
# Doi khoa nay = dang xuat moi phien admin (khong anh huong du lieu).
SESSION_SECRET=

# Khoa ma hoa AES-256-GCM cho CCCD / email / dien thoai (32 byte base64).
# CANH BAO: mat khoa nay = MAT VINH VIEN du lieu da ma hoa, khong co cach
# khoi phuc. Hay sao luu o noi an toan, tach khoi database.
# Neu dung OpenBao (xem OPENBAO.md) thi de trong bien nay.
ENCRYPTION_KEY=

# --- Gui email xac nhan cho khach ------------------------------------
# De TRONG SMTP_HOST -> che do DEV: email duoc ghi ra file .eml trong
# thu muc mail-dev/ (mo bang Outlook/Thunderbird), KHONG gui that.
#
# Gmail KHONG nhan mat khau thuong - phai bat 2FA roi tao "App Password"
# tai https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SkyBooking" <no-reply@example.com>
MAIL_DEV_DIR=mail-dev

# Email nhan canh bao bao mat. De trong -> chi in ra console.
ALERT_EMAIL=

# --- OpenBao (tuy chon) ----------------------------------------------
# Dua khoa ma hoa ra khoi .env. Chi tiet: OPENBAO.md
# De TRONG BAO_ADDR -> app dung .env nhu binh thuong.
#
# BAO_ROLE_ID + BAO_SECRET_ID la bootstrap credential duy nhat con lai
# tren dia. Thu hoi cap moi khi can:
#   bao write -f auth/approle/role/skybooking/secret-id
BAO_ADDR=
BAO_ROLE_ID=
BAO_SECRET_ID=
BAO_TRANSIT_KEY=skybooking-pii
BAO_KV_MOUNT=kv
BAO_KV_PATH=skybooking/app
